<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Mini Game untuk sygku Bisma 💙</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;

  font-family: "Segoe UI", Arial, sans-serif;

  background:
    radial-gradient(circle at 20% 20%, #ffffff 0 5%, transparent 6%),
    radial-gradient(circle at 80% 15%, #ffffff 0 4%, transparent 5%),
    linear-gradient(135deg, #dff7ff, #91dcfa);

  color: #16445c;
  overflow: hidden;
}

/* Dekorasi background */

.circle {
  position: fixed;
  border-radius: 50%;
  background: rgba(255,255,255,0.25);
  animation: float 5s infinite ease-in-out;
}

.c1 {
  width: 120px;
  height: 120px;
  top: 5%;
  left: -30px;
}

.c2 {
  width: 180px;
  height: 180px;
  bottom: -60px;
  right: -40px;
  animation-delay: 1s;
}

@keyframes float {
  50% {
    transform: translateY(-15px);
  }
}

/* Kotak utama */

.card {
  width: min(430px, 100%);
  max-height: 90vh;
  overflow-y: auto;

  background: rgba(255,255,255,0.95);

  border-radius: 30px;
  padding: 28px;

  text-align: center;

  box-shadow:
    0 20px 50px rgba(30, 120, 160, 0.25);

  position: relative;
  z-index: 2;

  animation: appear 0.6s ease;
}

@keyframes appear {
  from {
    opacity: 0;
    transform: translateY(20px) scale(.96);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.emoji {
  font-size: 58px;
  animation: bounce 1.8s infinite;
}

@keyframes bounce {
  50% {
    transform: translateY(-7px);
  }
}

h1 {
  margin: 8px 0;
  font-size: 30px;
}

h2 {
  font-size: 22px;
  line-height: 1.4;
  margin-bottom: 22px;
}

p {
  line-height: 1.6;
}

/* Tombol */

button {
  width: 100%;
  border: none;

  padding: 15px;
  margin: 7px 0;

  border-radius: 17px;

  font-size: 16px;
  font-weight: 600;

  cursor: pointer;

  background: #c8efff;
  color: #16445c;

  transition: 0.2s;
}

button:hover {
  transform: translateY(-3px);
  background: #a5e3fa;
}

button:active {
  transform: scale(.97);
}

.start {
  background: #54bfe8;
  color: white;
  font-size: 18px;
}

.start:hover {
  background: #38acd9;
}

/* Pilihan */

.option.selected {
  background: #54bfe8;
  color: white;
  transform: scale(1.02);
}

/* Progress */

.progress {
  height: 10px;
  background: #e5f7fd;

  border-radius: 20px;
  overflow: hidden;

  margin: 12px 0 25px;
}

.bar {
  height: 100%;
  width: 0%;

  background: #54bfe8;

  border-radius: 20px;

  transition: width .4s ease;
}

.count {
  font-size: 13px;
  color: #71909d;
}

/* Hidden */

.hidden {
  display: none;
}

/* Ending */

.end-message {
  animation: appear .7s ease;
}

.heart {
  font-size: 35px;
  margin-top: 15px;
}

.small {
  font-size: 12px;
  color: #78929d;
}

/* Confetti */

.confetti {
  position: fixed;
  top: -20px;
  font-size: 22px;
  animation: fall 3s linear forwards;
  z-index: 10;
}

@keyframes fall {
  to {
    transform: translateY(110vh) rotate(360deg);
    opacity: 0;
  }
}
</style>
</head>


<body>

<!-- Background decoration -->

<div class="circle c1"></div>
<div class="circle c2"></div>


<div class="card">

  <!-- HALAMAN START -->

  <div id="start">

    <div class="emoji">🎮💙</div>

    <h1>Mini Game untuk Bisma</h1>

    <p>
      Hai Bisma! 👀<br>
      Sebelum lanjut, jawab beberapa pertanyaan dulu yaa 😆
    </p>

    <button class="start" onclick="beginGame()">
      MULAI GAME →
    </button>

    <p class="small">
      Tenang, jawabanmu nggak disimpan atau dikirim ke siapa-siapa 🤫
    </p>

  </div>


  <!-- HALAMAN GAME -->

  <div id="game" class="hidden">

    <div class="count" id="count">
      Pertanyaan 1 dari 5
    </div>

    <div class="progress">
      <div class="bar" id="bar"></div>
    </div>

    <h2 id="question"></h2>

    <div id="options"></div>

  </div>


  <!-- HALAMAN ENDING -->

  <div id="end" class="hidden end-message">

    <div class="emoji">
      🎉💙
    </div>

    <h1>
      Yeay, kamu sampai di akhir!
    </h1>

    <p>
      Makasih ya udah mau main sebentar.
    </p>

    <p>
      Mungkin game ini sederhana,
      tapi aku bikinnya khusus buat kamu.
    </p>

    <p>
      Semoga setelah lihat ini kamu jadi tahu
      kalau ada seseorang yang seneng banget
      bisa kenal sama kamu.
    </p>

    <p>
      <b>
        Jangan lupa senyum hari ini hehe 😆💙
      </b>
    </p>

    <div class="heart">
      🩵 🩵 🩵
    </div>

    <button class="start" onclick="location.reload()">
      MAIN LAGI ↻
    </button>

  </div>

</div>


<script>

/* =========================
   DAFTAR PERTANYAAN
========================= */

const questions = [

  {
    q: "Menurut kamu, kita itu…? 👀",
    a: [
      "Biasa aja 😎",
      "Lumayan dekat",
      "Nyambung banget",
      "Hmm… rahasia 🤭"
    ]
  },

  {
    q: "Kalau aku tiba-tiba ngajak ngobrol, kamu…?",
    a: [
      "Seneng 😆",
      "B aja 😎",
      "Langsung bales",
      "Pura-pura sibuk 😭"
    ]
  },

  {
    q: "Kalau ada waktu luang, kamu lebih pilih…?",
    a: [
      "Main game 🎮",
      "Jalan-jalan 🚶",
      "Tidur 😴",
      "Ngobrol 💬"
    ]
  },

  {
    q: "Menurut kamu game ini…?",
    a: [
      "Lucu 😆",
      "Unik",
      "B aja",
      "Kok jadi penasaran ya 👀"
    ]
  },

  {
    q: "Terakhir… kamu seneng nggak bisa kenal sama aku?",
    a: [
      "Iya 💙",
      "Banget! 😭",
      "Hehe iya",
      "Next dulu 😭"
    ]
  }

];


/* =========================
   VARIABEL GAME
========================= */

let currentQuestion = 0;


/* =========================
   MULAI GAME
========================= */

function beginGame() {

  document
    .getElementById("start")
    .classList.add("hidden");

  document
    .getElementById("game")
    .classList.remove("hidden");

  showQuestion();
}


/* =========================
   MENAMPILKAN PERTANYAAN
========================= */

function showQuestion() {

  const question = questions[currentQuestion];

  document.getElementById("count").textContent =
    "Pertanyaan " +
    (currentQuestion + 1) +
    " dari " +
    questions.length;

  document.getElementById("question").textContent =
    question.q;


  /* Progress bar */

  const progress =
    (currentQuestion / questions.length) * 100;

  document.getElementById("bar").style.width =
    progress + "%";


  /* Membuat tombol pilihan */

  const options =
    document.getElementById("options");

  options.innerHTML = "";


  question.a.forEach(function(answer) {

    const button =
      document.createElement("button");

    button.className = "option";

    button.textContent = answer;


    button.onclick = function() {

      /* Efek tombol dipilih */

      button.classList.add("selected");


      /* Lanjut setelah sedikit delay */

      setTimeout(function() {

        currentQuestion++;


        if (
          currentQuestion <
          questions.length
        ) {

          showQuestion();

        } else {

          finishGame();

        }

      }, 300);

    };


    options.appendChild(button);

  });

}


/* =========================
   SELESAI GAME
========================= */

function finishGame() {

  document
    .getElementById("game")
    .classList.add("hidden");

  document
    .getElementById("end")
    .classList.remove("hidden");


  /* Progress penuh */

  document.getElementById("bar").style.width =
    "100%";


  /* Confetti */

  createConfetti();

}


/* =========================
   CONFETTI
========================= */

function createConfetti() {

  const symbols = [
    "💙",
    "🩵",
    "✨",
    "💫",
    "⭐",
    "🎉"
  ];


  for (let i = 0; i < 35; i++) {

    const confetti =
      document.createElement("div");

    confetti.className = "confetti";

    confetti.textContent =
      symbols[
        Math.floor(
          Math.random() * symbols.length
        )
      ];


    confetti.style.left =
      Math.random() * 100 + "vw";


    confetti.style.animationDuration =
      (2 + Math.random() * 2) + "s";


    confetti.style.animationDelay =
      Math.random() * 1.5 + "s";


    document.body.appendChild(confetti);


    setTimeout(function() {
      confetti.remove();
    }, 4500);

  }

}

</script>

</body>
</html>
